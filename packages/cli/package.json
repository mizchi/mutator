{
  "name": "@mizchi/mutator",
  "version": "0.0.0",
  "type": "module",
  "description": "Diff-driven mutation testing for Vitest",
  "license": "MIT",
  "author": "mizchi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/mutator.git",
    "directory": "packages/cli"
  },
  "bin": {
    "mutator": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "schema",
    "src"
  ],
  "dependencies": {
    "@mizchi/mutator-core": "workspace:*",
    "@mizchi/mutator-vitest": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "bin": {
      "mutator": "./dist/cli.js"
    }
  },
  "devDependencies": {
    "ajv": "8.20.0",
    "mutation-testing-report-schema": "3.9.0"
  }
}
