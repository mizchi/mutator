{
  "name": "@mizchi/mutator-playwright",
  "version": "0.1.0",
  "type": "module",
  "description": "Playwright Test adapter for @mizchi/mutator-core: mutation testing of browser code served by Vite (experimental)",
  "keywords": [
    "mutation-testing",
    "playwright",
    "e2e"
  ],
  "license": "MIT",
  "author": "mizchi",
  "homepage": "https://github.com/mizchi/mutator#readme",
  "bugs": "https://github.com/mizchi/mutator/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/mutator.git",
    "directory": "packages/playwright"
  },
  "exports": {
    ".": "./src/index.ts",
    "./vite": "./src/vite.ts",
    "./session": "./src/session.ts"
  },
  "files": [
    "dist",
    "skills",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@playwright/test": ">=1.50.0",
    "vite": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "@playwright/test": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "dependencies": {
    "@mizchi/mutator-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./vite": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.js"
      },
      "./session": {
        "types": "./dist/session.d.ts",
        "default": "./dist/session.js"
      }
    }
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "vite": "8.3.4"
  }
}
