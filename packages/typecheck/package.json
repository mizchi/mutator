{
  "name": "@mizchi/mutator-typecheck",
  "version": "0.1.0",
  "type": "module",
  "description": "Type-check mutants with the project's TypeScript (6 via the compiler API, 7 via the native API)",
  "keywords": [
    "mutation-testing",
    "typescript"
  ],
  "license": "MIT",
  "author": "mizchi",
  "homepage": "https://github.com/mizchi/mutator#readme",
  "bugs": "https://github.com/mizchi/mutator/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/mutator.git",
    "directory": "packages/typecheck"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "dependencies": {
    "@mizchi/mutator-core": "workspace:*"
  },
  "devDependencies": {
    "typescript6": "npm:typescript@6.0.3",
    "typescript7": "npm:typescript@7.0.2"
  }
}
