{
  "name": "@mizchi/mutator-vitest",
  "version": "0.0.0",
  "type": "module",
  "description": "Vitest adapter for @mizchi/mutator-core",
  "keywords": [
    "mutation-testing",
    "vitest"
  ],
  "license": "MIT",
  "author": "mizchi",
  "homepage": "https://github.com/mizchi/mutator#readme",
  "bugs": "https://github.com/mizchi/mutator/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mizchi/mutator.git",
    "directory": "packages/vitest"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "vitest": "5.0.3"
  },
  "peerDependencies": {
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "@mizchi/mutator-core": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "tsc -p tsconfig.build.json"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  }
}
